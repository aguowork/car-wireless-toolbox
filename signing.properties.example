# 公开配置模板。先复制为 signing.properties，再填写本地签名信息。
# 完整说明：docs/SIGNING.md
# signing.properties、*.jks 和 *.keystore 已在 .gitignore 中。
# Windows 路径请使用正斜杠，例如 C:/keys/car-wireless-release.jks。
# Android 4.2.2 要求 v1 签名，项目同时开启 v2，关闭 v3/v4。

storeFile=/path/to/your-release.jks
storePassword=your_store_password
keyAlias=carwireless
keyPassword=your_key_password
